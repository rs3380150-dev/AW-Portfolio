{
  "name": "achyut-wadhwa-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/formatEventDate.test.mjs tests/publicAssets.test.mjs",
    "check": "npm run test && npm run build",
    "media:sync": "powershell -ExecutionPolicy Bypass -File ../scripts/sync-remote-media.ps1",
    "media:upload": "node ../scripts/upload-cloudinary-media.mjs",
    "media:verify": "node ../scripts/verify-cloudinary-media.mjs",
    "media:cleanup": "node ../scripts/cleanup-uploaded-media.mjs --confirm-uploaded=41",
    "press-kit": "python ../scripts/generate_press_kit.py",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.468.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cloudinary": "^2.10.1",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "^5.4.11"
  }
}
