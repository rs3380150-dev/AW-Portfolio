# Public site URL used for canonical links and SEO metadata.
VITE_SITE_URL=https://novapulse.in

# Create an access key at Web3Forms for the booking form.
VITE_WEB3FORMS_ACCESS_KEY=

# Supabase public browser credentials (Project Settings > API).
# The anon/publishable key is safe for browser use when RLS is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side Cloudinary upload credentials. Never prefix the secret with VITE_.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
